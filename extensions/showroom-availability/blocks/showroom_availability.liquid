<div
  id="showroom-availability-{{ block.id }}"
  class="showroom-availability"
  data-product-id="{{ product.id }}"
  style="display:none;"
>
  <div class="showroom-availability__label">
    AVAILABLE AT
  </div>

  <div class="showroom-availability__location">
    <span class="showroom-availability__name"></span>
    <span class="showroom-availability__status">In Stock</span>
  </div>

  <div class="showroom-availability__message"></div>
</div>

<style>
   .uae-flag {
    display: inline-block;
    width: 22px;
    height: 15px;
    margin-right: 7px;
    vertical-align: -2px;
    position: relative;
    border-radius: 1px;
    background: linear-gradient(
      to bottom,
      #00732f 0%,
      #00732f 33.33%,
      #ffffff 33.33%,
      #ffffff 66.66%,
      #000000 66.66%,
      #000000 100%
    );
  }

  .uae-flag {
  display: inline-block !important;
  width: 24px !important;
  height: 16px !important;
  margin-right: 8px !important;
  position: relative !important;
  flex-shrink: 0 !important;
  vertical-align: middle !important;
  background: linear-gradient(
    to bottom,
    #00732f 0%,
    #00732f 33.33%,
    #ffffff 33.33%,
    #ffffff 66.66%,
    #000000 66.66%,
    #000000 100%
  ) !important;
  border-radius: 1px !important;
  overflow: hidden !important;
}

.uae-flag::before {
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 6px !important;
  height: 100% !important;
  background: #ff0000 !important;
  display: block !important;
}
</style>

<script>
  (function () {
    const block = document.getElementById(
      "showroom-availability-{{ block.id }}"
    );

    if (!block) return;

    const productId = block.dataset.productId;

    if (!productId) return;

    fetch(
      `/apps/showroom-availability?product_id=${encodeURIComponent(productId)}`,
      {
        method: "GET",
        headers: {
          Accept: "application/json"
        }
      }
    )
      .then(function (response) {
        if (!response.ok) {
          throw new Error("Showroom availability request failed");
        }

        return response.json();
      })
      .then(function (data) {
        const dubai = data.dubai === true;
        const abuDhabi = data.abuDhabi === true;

        const location = block.querySelector(
          ".showroom-availability__name"
        );

        const message = block.querySelector(
          ".showroom-availability__message"
        );

        /*
         * Neither showroom has stock:
         * keep the entire block hidden.
         */
        if (!dubai && !abuDhabi) {
          return;
        }

        /*
         * Both showrooms have stock.
         */
        if (dubai && abuDhabi) {
          location.innerHTML =
  '<span class="uae-flag" aria-hidden="true"></span><span>Dubai & Abu Dhabi Showrooms</span>';

          message.textContent =
            "This product will be shipped from either of our showrooms.";
        }

        /*
         * Dubai only.
         */
        else if (dubai) {
          location.innerHTML =
  '<span class="uae-flag" aria-hidden="true"></span><span>Dubai Showroom</span>';

          message.textContent =
            "This product will be shipped from our Dubai showroom.";
        }

        /*
         * Abu Dhabi only.
         */
        else if (abuDhabi) {
          location.innerHTML =
  '<span class="uae-flag" aria-hidden="true"></span><span>Abu Dhabi Showroom</span>';

          message.textContent =
            "This product will be shipped from our Abu Dhabi showroom.";
        }

        block.style.display = "block";
      })
      .catch(function (error) {
        console.error(
          "Showroom availability:",
          error
        );

        /*
         * If the request fails, don't show
         * an incorrect availability message.
         */
        block.style.display = "none";
      });
  })();
</script>

{% schema %}
{
  "name": "Showroom Availability",
  "target": "section",
  "settings": []
}
{% endschema %}
